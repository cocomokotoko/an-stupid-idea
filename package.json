{
  "name": "my-app-space",
  "version": "1.0.0",
  "description": "A little home for the things you make.",
  "author": "My app space",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:publish": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.myappspace.desktop",
    "productName": "My app space",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*.cjs",
      "emoji-data.json",
      "index.html",
      "install.html",
      "manifest.webmanifest",
      "icon.svg"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "cocomokotoko",
      "repo": "an-stupid-idea"
    }
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "electron-updater": "^6.8.11"
  }
}
